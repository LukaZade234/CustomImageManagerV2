{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* Incremental adoption: .js and .jsx keep working untouched.
       checkJs stays false so existing JavaScript is not type-checked --
       only files you actually convert to .ts/.tsx are. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Vite owns the build; tsc is only a checker. */
    "noEmit": true
  },
  "include": ["src"]
}

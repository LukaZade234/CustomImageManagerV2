{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": { "includes": ["src/**", "*.js", "*.json"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Matches the existing hand-written style so enabling the formatter
    // is not a 4000-line rewrite.
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        // Not on by default, and it should be. A reference to a variable that
        // was deleted during a refactor builds cleanly, passes every test that
        // does not exercise that exact line, and throws in the browser — which
        // is precisely what happened when reorder moved to pointer events and
        // two file-drop handlers were left pointing at a removed piece of state.
        "noUndeclaredVariables": "error"
      },
      "style": {
        // On since legacy.css was retired. It catches a base rule written after
        // a modifier that already constrains the same element, which reads as a
        // rule that mysteriously does not apply.
        "noDescendingSpecificity": "error"
      },
      "complexity": {
        // Was off because dark mode was implemented as !important overrides.
        // The token layer removed all 33 of them, so the rule now guards
        // against them coming back.
        "noImportantStyles": "error"
      },
      "suspicious": {
        // False positives: flags arrow callbacks passed to forEach, which
        // discards return values. Verified both hits are harmless.
        "useIterableCallbackReturn": "off"
      }
    }
  }
}

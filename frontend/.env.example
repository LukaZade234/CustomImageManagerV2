# Frontend build-time configuration.
#
# Vite inlines these into the bundle, so nothing secret belongs here.
# Copy to .env.production and fill in before building for Cloudflare Pages.
#
# Leave both empty for local development: the Vite dev server proxies to Flask
# on :5000, so everything is same-origin.

# Origin of the Flask API, behind the Cloudflare Tunnel.
VITE_API_BASE_URL=https://api.example.com

# Where the default character images are served from (R2 with a custom domain).
# The path /character_images/<file> is appended to this.
VITE_IMAGE_BASE_URL=https://images.example.com
